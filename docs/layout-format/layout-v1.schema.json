{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pocketpad-layout"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "inputType": {
      "enum": [
        "keyboardMouse",
        "gamepad"
      ]
    },
    "controllerStyle": {
      "enum": [
        "xbox",
        "playstation"
      ]
    },
    "haptics": {
      "enum": [
        "off",
        "light",
        "medium",
        "strong"
      ],
      "default": "medium"
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "outputs": {
            "type": "array",
            "items": {
              "enum": [
                "key.a",
                "key.b",
                "key.c",
                "key.d",
                "key.e",
                "key.f",
                "key.g",
                "key.h",
                "key.i",
                "key.j",
                "key.k",
                "key.l",
                "key.m",
                "key.n",
                "key.o",
                "key.p",
                "key.q",
                "key.r",
                "key.s",
                "key.t",
                "key.u",
                "key.v",
                "key.w",
                "key.x",
                "key.y",
                "key.z",
                "key.one",
                "key.two",
                "key.three",
                "key.four",
                "key.five",
                "key.six",
                "key.seven",
                "key.eight",
                "key.nine",
                "key.zero",
                "key.space",
                "key.shift",
                "key.control",
                "key.option",
                "key.command",
                "key.tab",
                "key.escape",
                "key.enter",
                "key.backspace",
                "key.up",
                "key.down",
                "key.left",
                "key.right",
                "key.minus",
                "key.equal",
                "key.leftBracket",
                "key.rightBracket",
                "key.semicolon",
                "key.quote",
                "key.comma",
                "key.period",
                "key.slash",
                "key.backslash",
                "key.grave",
                "key.f1",
                "key.f2",
                "key.f3",
                "key.f4",
                "key.f5",
                "key.f6",
                "key.f7",
                "key.f8",
                "key.f9",
                "key.f10",
                "key.f11",
                "key.f12",
                "mouse.left",
                "mouse.right",
                "mouse.middle",
                "mouse.scrollUp",
                "mouse.scrollDown",
                "pointer.relative",
                "pointer.cursor",
                "axis.leftStick",
                "axis.rightStick",
                "gamepad.south",
                "gamepad.east",
                "gamepad.west",
                "gamepad.north",
                "gamepad.leftShoulder",
                "gamepad.rightShoulder",
                "gamepad.leftTrigger",
                "gamepad.rightTrigger",
                "gamepad.back",
                "gamepad.start",
                "gamepad.guide",
                "gamepad.leftClick",
                "gamepad.rightClick",
                "gamepad.dpadUp",
                "gamepad.dpadRight",
                "gamepad.dpadDown",
                "gamepad.dpadLeft"
              ]
            },
            "maxItems": 4,
            "uniqueItems": true
          },
          "behavior": {
            "enum": [
              "hold",
              "tap"
            ],
            "default": "hold"
          }
        },
        "required": [
          "label",
          "outputs"
        ]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "kind": {
            "enum": [
              "button",
              "stick",
              "dpad",
              "radial"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "size": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1
          },
          "bindings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "press": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "up": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "upRight": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "right": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "downRight": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "down": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "downLeft": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "left": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "upLeft": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "axis": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "centerHold": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              }
            },
            "required": []
          }
        },
        "required": [
          "id",
          "kind",
          "x",
          "y",
          "size",
          "bindings"
        ]
      }
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "name",
    "inputType",
    "actions",
    "controls"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pocket Pad layout document draft \u2014 not yet a runtime import format",
  "allOf": [
    {
      "if": {
        "properties": {
          "inputType": {
            "const": "gamepad"
          }
        }
      },
      "then": {
        "required": [
          "controllerStyle"
        ]
      }
    }
  ]
}
