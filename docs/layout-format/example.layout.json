{
  "format": "pocketpad-layout",
  "schemaVersion": 1,
  "name": "Movement and jump",
  "inputType": "keyboardMouse",
  "actions": {
    "forward": {
      "label": "Forward",
      "outputs": [
        "key.w"
      ]
    },
    "backward": {
      "label": "Backward",
      "outputs": [
        "key.s"
      ]
    },
    "left": {
      "label": "Left",
      "outputs": [
        "key.a"
      ]
    },
    "right": {
      "label": "Right",
      "outputs": [
        "key.d"
      ]
    },
    "jump": {
      "label": "Jump",
      "outputs": [
        "key.space"
      ]
    }
  },
  "controls": [
    {
      "id": "movement",
      "kind": "stick",
      "x": 0.2,
      "y": 0.65,
      "size": 0.3,
      "bindings": {
        "up": "forward",
        "down": "backward",
        "left": "left",
        "right": "right"
      }
    },
    {
      "id": "jump",
      "kind": "button",
      "x": 0.8,
      "y": 0.65,
      "size": 0.15,
      "bindings": {
        "press": "jump"
      }
    }
  ]
}
