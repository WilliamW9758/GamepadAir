{
  "format": "pocketpad-layout",
  "schemaVersion": 2,
  "runtimeProfile": "pocketpad-fixed-v1",
  "name": "Quick slots and radial",
  "inputType": "keyboardMouse",
  "templateStyle": "xbox",
  "geometry": "runtimePresetV1",
  "actions": {
    "forward": {
      "label": "Forward",
      "outputs": [
        "key.w"
      ]
    },
    "backward": {
      "label": "Backward",
      "outputs": [
        "key.s"
      ]
    },
    "left": {
      "label": "Left",
      "outputs": [
        "key.a"
      ]
    },
    "right": {
      "label": "Right",
      "outputs": [
        "key.d"
      ]
    },
    "jump": {
      "label": "Jump",
      "outputs": [
        "key.space"
      ]
    },
    "slot-one": {
      "label": "Slot 1",
      "outputs": [
        "key.one"
      ],
      "behavior": "tap"
    },
    "slot-two": {
      "label": "Slot 2",
      "outputs": [
        "key.two"
      ],
      "behavior": "tap"
    }
  },
  "controls": [
    {
      "id": "movement",
      "role": "leftStick",
      "placement": {
        "x": 0.2,
        "y": 0.65
      },
      "bindings": {
        "up": "forward",
        "down": "backward",
        "left": "left",
        "right": "right"
      }
    },
    {
      "id": "jump",
      "role": "south",
      "label": "Jump",
      "placement": {
        "x": 0.8,
        "y": 0.65
      },
      "bindings": {
        "press": "jump"
      }
    },
    {
      "id": "slot-one",
      "role": "customButton",
      "customSlot": 0,
      "label": "1",
      "bindings": {
        "press": "slot-one"
      }
    },
    {
      "id": "slot-two",
      "role": "customButton",
      "customSlot": 1,
      "hidden": true,
      "bindings": {
        "press": "slot-two"
      }
    },
    {
      "id": "quick-select",
      "role": "radial",
      "label": "Quick select",
      "radialSlots": {
        "up": "slot-one",
        "down": "slot-two"
      }
    }
  ],
  "modes": [
    {
      "id": "explore",
      "name": "Explore",
      "holdAimEnabled": false
    }
  ],
  "initialMode": "explore",
  "keyboard": {
    "rightStickMouse": false
  }
}
