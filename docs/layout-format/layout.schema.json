{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "pocketpad-layout"
    },
    "schemaVersion": {
      "const": 2
    },
    "runtimeProfile": {
      "const": "pocketpad-fixed-v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "inputType": {
      "enum": [
        "keyboardMouse",
        "gamepad"
      ]
    },
    "templateStyle": {
      "enum": [
        "xbox",
        "playstation"
      ]
    },
    "controllerStyle": {
      "enum": [
        "xbox",
        "playstation"
      ]
    },
    "haptics": {
      "enum": [
        "off",
        "light",
        "medium",
        "strong"
      ],
      "default": "medium"
    },
    "geometry": {
      "const": "runtimePresetV1",
      "description": "Development v2 point-based runtime presets: fixed point control sizes, minimum 44-point extent, normalized positions. Requires layout sync protocol 5."
    },
    "actions": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "outputs": {
            "type": "array",
            "items": {
              "enum": [
                "key.a",
                "key.b",
                "key.c",
                "key.d",
                "key.e",
                "key.f",
                "key.g",
                "key.h",
                "key.i",
                "key.j",
                "key.k",
                "key.l",
                "key.m",
                "key.n",
                "key.o",
                "key.p",
                "key.q",
                "key.r",
                "key.s",
                "key.t",
                "key.u",
                "key.v",
                "key.w",
                "key.x",
                "key.y",
                "key.z",
                "key.one",
                "key.two",
                "key.three",
                "key.four",
                "key.five",
                "key.six",
                "key.seven",
                "key.eight",
                "key.nine",
                "key.zero",
                "key.space",
                "key.shift",
                "key.control",
                "key.option",
                "key.command",
                "key.tab",
                "key.escape",
                "key.enter",
                "key.backspace",
                "key.up",
                "key.down",
                "key.left",
                "key.right",
                "key.minus",
                "key.equal",
                "key.leftBracket",
                "key.rightBracket",
                "key.semicolon",
                "key.quote",
                "key.comma",
                "key.period",
                "key.slash",
                "key.backslash",
                "key.grave",
                "key.f1",
                "key.f2",
                "key.f3",
                "key.f4",
                "key.f5",
                "key.f6",
                "key.f7",
                "key.f8",
                "key.f9",
                "key.f10",
                "key.f11",
                "key.f12",
                "mouse.left",
                "mouse.right",
                "mouse.middle",
                "mouse.scrollUp",
                "mouse.scrollDown",
                "gamepad.south",
                "gamepad.east",
                "gamepad.west",
                "gamepad.north",
                "gamepad.leftShoulder",
                "gamepad.rightShoulder",
                "gamepad.leftTrigger",
                "gamepad.rightTrigger",
                "gamepad.back",
                "gamepad.start",
                "gamepad.guide",
                "gamepad.leftClick",
                "gamepad.rightClick",
                "gamepad.dpadUp",
                "gamepad.dpadRight",
                "gamepad.dpadDown",
                "gamepad.dpadLeft"
              ]
            },
            "maxItems": 4,
            "uniqueItems": true
          },
          "behavior": {
            "enum": [
              "hold",
              "tap"
            ],
            "default": "hold"
          }
        },
        "required": [
          "label",
          "outputs"
        ]
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 35,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/mode"
      }
    },
    "initialMode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,47}$"
    },
    "linkedControls": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 35,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,47}$"
      }
    },
    "keyboard": {
      "$ref": "#/$defs/keyboard"
    },
    "gamepad": {
      "$ref": "#/$defs/gamepad"
    },
    "motion": {
      "$ref": "#/$defs/motion"
    }
  },
  "required": [
    "format",
    "schemaVersion",
    "runtimeProfile",
    "name",
    "inputType",
    "templateStyle",
    "geometry",
    "actions",
    "controls",
    "modes",
    "initialMode"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketPad portable layout v2 draft \u2014 current fixed-slot runtime",
  "$defs": {
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "minimum": 0.65,
          "maximum": 1.8,
          "default": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 1,
          "description": "Trackpad: fraction of actual canvas width. Custom button: fraction of fixed 800-point design width. Resolved extent is at least 44 points and fits the canvas."
        },
        "height": {
          "type": "number",
          "minimum": 0.03,
          "maximum": 1,
          "description": "Trackpad: fraction of actual canvas height. Custom button: fraction of fixed 320-point design height. Resolved extent is at least 44 points and fits the canvas."
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "haptic": {
          "enum": [
            "off",
            "light",
            "medium",
            "strong"
          ]
        },
        "tint": {
          "enum": [
            "automatic",
            "mint",
            "blue",
            "violet",
            "pink",
            "red",
            "orange",
            "yellow",
            "white"
          ]
        }
      },
      "required": [
        "haptic",
        "tint"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "role": {
          "enum": [
            "south",
            "east",
            "west",
            "north",
            "leftShoulder",
            "rightShoulder",
            "back",
            "start",
            "leftClick",
            "rightClick",
            "guide",
            "leftTrigger",
            "rightTrigger",
            "leftStick",
            "rightStick",
            "dpad",
            "customButton",
            "radial",
            "modeSwitch",
            "trackpad"
          ]
        },
        "customSlot": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "press": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "up": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "right": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "down": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "left": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            }
          },
          "required": []
        },
        "radialSlots": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "up": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "upRight": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "right": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "downRight": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "down": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "downLeft": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "left": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            },
            "upLeft": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,47}$"
            }
          },
          "required": []
        },
        "command": {
          "const": "cycleModes"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "feedback": {
          "$ref": "#/$defs/feedback"
        }
      },
      "required": [
        "id",
        "role"
      ]
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "pointerMode": {
          "enum": [
            "aim",
            "cursor"
          ],
          "default": "aim"
        },
        "sizeFactor": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 3,
          "default": 1
        },
        "dpadStyle": {
          "enum": [
            "fourWay",
            "eightWay"
          ],
          "default": "eightWay"
        },
        "holdAimEnabled": {
          "type": "boolean",
          "default": true
        },
        "holdAimDelay": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0.3
        },
        "trackpadHoldDelay": {
          "type": "number",
          "minimum": 0,
          "maximum": 5,
          "default": 0.5
        },
        "floatingLeft": {
          "type": "boolean",
          "default": false
        },
        "floatingRight": {
          "type": "boolean",
          "default": false
        },
        "leftTap": {
          "enum": [
            "off",
            "leftClick",
            "rightTrigger",
            "rightClick",
            "leftTrigger"
          ],
          "default": "off"
        },
        "rightTap": {
          "enum": [
            "off",
            "leftClick",
            "rightTrigger",
            "rightClick",
            "leftTrigger"
          ],
          "default": "off"
        },
        "overrides": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,47}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "placement": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/placement"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "hidden": {
                "type": "boolean",
                "default": false
              },
              "feedback": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/feedback"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": []
          }
        },
        "trackpadScroll": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "keyboard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mouseSpeed": {
          "type": "number",
          "minimum": 100,
          "maximum": 2400,
          "default": 900
        },
        "mouseSmoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.08,
          "default": 0.025
        },
        "relativeGameAim": {
          "type": "boolean",
          "default": true
        },
        "mouseUpdateRate": {
          "enum": [
            250,
            500,
            1000
          ],
          "default": 1000
        },
        "rightStickMouse": {
          "type": "boolean",
          "default": true
        },
        "autoRunEnabled": {
          "type": "boolean",
          "default": false
        },
        "autoRunThreshold": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.95,
          "default": 0.8
        },
        "autoRunAction": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$"
        },
        "invertMouseY": {
          "type": "boolean",
          "default": false
        },
        "stickThreshold": {
          "type": "number",
          "minimum": 0.15,
          "maximum": 0.8,
          "default": 0.35
        },
        "comboGap": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.1,
          "default": 0.03
        },
        "tapDuration": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.5,
          "default": 0.12
        }
      },
      "required": []
    },
    "gamepad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "swapSticks": {
          "type": "boolean",
          "default": false
        },
        "disableLeftStick": {
          "type": "boolean",
          "default": false
        },
        "disableRightStick": {
          "type": "boolean",
          "default": false
        },
        "invertLeftY": {
          "type": "boolean",
          "default": false
        },
        "invertRightY": {
          "type": "boolean",
          "default": false
        }
      },
      "required": []
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "off",
            "aim",
            "steering"
          ],
          "default": "off"
        },
        "sensitivity": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4,
          "default": 1
        },
        "deadZone": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "default": 0.03
        },
        "activationControl": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,47}$",
          "description": "ID of a button or trigger held to activate motion. Omitted uses the right trigger."
        }
      },
      "required": []
    }
  }
}
